# Personal PIN is the default. Use account only when intentionally enabling account login.
VITE_ACCESS_MODE=pin
# Optional cloud configuration. Local PIN use does not require Supabase.
# Never use a service-role/secret key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Keep this legacy plan UID when upgrading; map it to your Auth user in SQL.
VITE_OWNER_UID=e8a57bf1-58c2-45ae-b1ab-65c1e6921ad9

# GEMINI_API_KEY belongs to Supabase Edge Function secrets, not VITE_*.
